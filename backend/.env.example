# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000
APP_URL=http://localhost:3000

# --- Admin dashboard login (frontend: /admin) ---
# On startup, an admin account is created/updated with these credentials.
# Set a real, unique password before deploying — this account can see every
# booking, chat thread, and uploaded floor plan.
ADMIN_EMAIL=admin@vastu360.com
ADMIN_PASSWORD=admin123$

# --- AI chat (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- TNG Digital payment ---
# Leave MOCK_PAYMENT=true to develop/test the full booking -> payment -> report
# flow without real TNG credentials. Every mock order auto-confirms as paid.
# Set to false once you have real sandbox/production credentials below.
MOCK_PAYMENT=true

TNG_MERCHANT_ID=
TNG_CLIENT_ID=
# PEM-formatted RSA private key used to sign requests (see TNG Digital docs).
# Easiest to store the key in a file and read it at startup rather than in .env directly.
TNG_PRIVATE_KEY_PATH=./tng-private-key.pem
TNG_PAYMENT_ENDPOINT=https://open.tngdigital.com.my/gateway/api/v1/payments/pay

# --- WhatsApp purchase alerts (Meta WhatsApp Cloud API) ---
# Leave blank to just log the alert to the console instead of sending it —
# useful for local development. See notifications.js for setup notes.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Where purchase alerts are sent, international format, no + or spaces.
# 012-700 5081 (Malaysia) -> 60127005081
OWNER_WHATSAPP_NUMBER=60127005081

# --- Report review (owner approves before the customer gets the report) ---
# Public URL of THIS backend (used in the WhatsApp review link). Falls back to APP_URL.
BACKEND_PUBLIC_URL=http://localhost:3000
# Secret used to sign the review links sent to WhatsApp. Use a long random string.
REVIEW_SECRET=

# --- Email alerts (sent alongside WhatsApp, same "report ready for review" alert) ---
# NOTE: this uses the Resend HTTPS API, not SMTP — Render blocks outbound SMTP
# ports (25/465/587) on free/starter plans, so a direct connection to any SMTP
# server (Hostinger included) will time out. Resend's API runs over normal
# HTTPS and isn't affected by that block.
OWNER_EMAIL=info@vastu360.my
# 1. Sign up free at https://resend.com and create an API key -> paste below.
RESEND_API_KEY=
# 2. Optional: once you verify vastu360.my as a sending domain in Resend
#    (Resend dashboard -> Domains -> Add Domain -> add the DNS records it
#    gives you in Hostinger's DNS settings), set this so alerts come from
#    your own address instead of Resend's shared test one:
# RESEND_FROM=Vastu360 Alerts <info@vastu360.my>
