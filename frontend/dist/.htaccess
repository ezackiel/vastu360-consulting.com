# Single-page app fallback: if the requested file/folder doesn't actually
# exist on the server (e.g. /admin), serve index.html instead of a 404 so
# the app's own routing logic (in main.jsx) can take over.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
